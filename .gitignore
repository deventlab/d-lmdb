# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.rules

# Local LMDB data directories generated by examples/tests, and LMDB's own files
# wherever they end up (belt-and-suspenders alongside the directory ignores above).
/data/
/db/
/logs/
**/*.mdb

# OS / editor / local AI-agent tooling config
.DS_Store
.zed/
.agents/

# Workspace now includes d-lmdb-server, a deployable binary — commit Cargo.lock
# for reproducible builds. (d-lmdb the library still doesn't need one committed
# on its own, but Cargo workspaces share a single lockfile at the root.)

# Developer's real d-lmdb-server config, copied from config.example.toml — may
# contain machine-local paths, gets regenerated per-developer, never committed.
/d-lmdb-server/config.toml
